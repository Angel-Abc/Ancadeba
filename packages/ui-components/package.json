{
  "name": "@ancadeba/ui-components",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "development": "./src/index.ts"
      },
      "import": "./dist/index.js"
    },
    "./scene.css": "./src/scene.css",
    "./game.css": "./src/game.css",
    "./variables.css": "./src/variables.css"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ancadeba/game-runtime": "workspace:*",
    "@ancadeba/schemas": "workspace:*",
    "@ancadeba/utilities": "workspace:*"
  }
}
