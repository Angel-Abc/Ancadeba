{
  "schema-version": "1.0.0",
  "id": "market-value",
  "title": "Market Value",
  "description": "Because everything has a price",
  "version": "1.0.0",
  "saving": {
    "manual": "anywhere",
    "autosave": "automatic"
  },
  "menu-scene": "game-menu",
  "initial-scene": "start",
  "stylesheet": "theme.css",
  "scenes": [
    "start",
    "create-character",
    "adventure",
    "appearance",
    "game-menu",
    "character",
    "save",
    "load",
    "settings"
  ],
  "assets": "catalogue",
  "maps": ["coast"],
  "inventory": ["items"],
  "rules": ["beach-pickups", "character"],
  "forms": ["appearance"],
  "characterProfile": {
    "fields": [
      {
        "id": "gender",
        "label": "Gender",
        "path": ["character", "gender"],
        "options": [
          {
            "id": "woman",
            "label": "Woman"
          },
          {
            "id": "man",
            "label": "Man"
          },
          {
            "id": "nonbinary",
            "label": "Nonbinary"
          },
          {
            "id": "undisclosed",
            "label": "Prefer not to say"
          }
        ],
        "default": "undisclosed"
      },
      {
        "id": "skin-tone",
        "label": "Skin tone",
        "path": ["character", "skin-tone"],
        "options": [
          {
            "id": "light",
            "label": "Light"
          },
          {
            "id": "warm",
            "label": "Warm"
          },
          {
            "id": "olive",
            "label": "Olive"
          },
          {
            "id": "brown",
            "label": "Brown"
          },
          {
            "id": "deep",
            "label": "Deep"
          }
        ],
        "default": "warm"
      },
      {
        "id": "hairstyle",
        "label": "Hairstyle",
        "path": ["character", "hairstyle"],
        "options": [
          {
            "id": "crop",
            "label": "Cropped"
          },
          {
            "id": "waves",
            "label": "Wavy"
          },
          {
            "id": "tied",
            "label": "Tied back"
          }
        ],
        "default": "crop"
      },
      {
        "id": "hair-color",
        "label": "Hair color",
        "path": ["character", "hair-color"],
        "options": [
          {
            "id": "black",
            "label": "Black"
          },
          {
            "id": "brown",
            "label": "Brown"
          },
          {
            "id": "auburn",
            "label": "Auburn"
          },
          {
            "id": "blond",
            "label": "Blond"
          }
        ],
        "default": "black"
      }
    ],
    "portrait": {
      "visual": "castaway",
      "appearance": {
        "colors": {},
        "visible": true,
        "slots": {
          "body": {
            "colors": {},
            "visible": true,
            "bindings": {
              "palette": {
                "source": "game.state",
                "path": ["character", "skin-tone"]
              },
              "colors": {}
            }
          },
          "face": {
            "colors": {},
            "visible": true,
            "bindings": {
              "palette": {
                "source": "game.state",
                "path": ["character", "skin-tone"]
              },
              "colors": {}
            },
            "partBinding": {
              "source": "game.state",
              "path": ["character", "gender"]
            }
          },
          "hair": {
            "colors": {},
            "visible": true,
            "bindings": {
              "palette": {
                "source": "game.state",
                "path": ["character", "hair-color"]
              },
              "colors": {}
            },
            "partBinding": {
              "source": "game.state",
              "path": ["character", "hairstyle"]
            }
          }
        }
      }
    }
  }
}
