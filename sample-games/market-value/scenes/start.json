{
  "schema-version": "1.0.0",
  "id": "start",
  "title": "Start",
  "description": "",
  "type": "stand-alone",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 16
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": {
        "row": 2,
        "column": 2,
        "rowSpan": 3,
        "columnSpan": 10
      },
      "text": "Market Value",
      "presentation": {
        "variant": "heading",
        "align": "start"
      }
    },
    {
      "id": "play",
      "type": "button",
      "placement": {
        "row": 5,
        "column": 2,
        "rowSpan": 2,
        "columnSpan": 5
      },
      "label": "New game",
      "action": {
        "type": "enter-scene",
        "scene": "create-character"
      }
    },
    {
      "id": "load",
      "type": "button",
      "placement": {
        "row": 7,
        "column": 2,
        "rowSpan": 2,
        "columnSpan": 5
      },
      "label": "Load game",
      "action": {
        "type": "enter-scene",
        "scene": "load"
      }
    },
    {
      "id": "settings",
      "type": "button",
      "placement": {
        "row": 9,
        "column": 2,
        "rowSpan": 2,
        "columnSpan": 5
      },
      "label": "Settings",
      "action": {
        "type": "enter-scene",
        "scene": "settings"
      }
    },
    {
      "id": "shoreline",
      "type": "background-image",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 12,
        "columnSpan": 16
      },
      "image": "shoreline-at-dawn",
      "fit": "cover"
    }
  ]
}
