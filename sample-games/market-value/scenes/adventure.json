{
  "schema-version": "1.0.0",
  "id": "adventure",
  "title": "Adventure",
  "description": "",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 32,
      "columns": 32
    }
  },
  "components": [
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 2,
        "rowSpan": 3,
        "columnSpan": 9
      },
      "text": "You wake on a beach with wet sand against your cheek. A blinding headache makes you squeeze your eyes shut. You try to remember how you got here, then try to remember your own name. Nothing comes. A few scraps of fabric cling to your skin. They’re all you have.",
      "presentation": {
        "variant": "body",
        "align": "start"
      }
    },
    {
      "id": "edit-appearance",
      "type": "button",
      "label": "Edit appearance",
      "placement": {
        "row": 13,
        "column": 11,
        "rowSpan": 1,
        "columnSpan": 5
      },
      "action": {
        "type": "enter-scene",
        "scene": "appearance"
      }
    },
    {
      "id": "menu",
      "type": "button",
      "placement": {
        "row": 12,
        "column": 11,
        "rowSpan": 1,
        "columnSpan": 5
      },
      "label": "Game menu (Escape)",
      "action": {
        "type": "open-menu",
        "scene": "game-menu"
      }
    },
    {
      "id": "coast-map",
      "type": "map-view",
      "placement": {
        "row": 4,
        "column": 2,
        "rowSpan": 8,
        "columnSpan": 14
      },
      "map": "coast",
      "label": "Coast",
      "viewport": {
        "columns": 24,
        "rows": 14,
        "x": 0,
        "y": 0
      },
      "playerSpawn": {
        "x": 8,
        "y": 9
      },
      "interactive": true
    },
    {
      "id": "player-inventory",
      "type": "inventory",
      "placement": {
        "row": 1,
        "column": 11,
        "rowSpan": 3,
        "columnSpan": 5
      },
      "label": "Inventory",
      "owners": ["player"],
      "previews": {},
      "readOnly": true
    },
    {
      "id": "pickup-help",
      "type": "text",
      "placement": {
        "row": 12,
        "column": 2,
        "rowSpan": 1,
        "columnSpan": 9
      },
      "text": "Use arrow keys to move. Select an item beside you to pick it up.",
      "presentation": {
        "variant": "body",
        "align": "start"
      }
    }
  ]
}
