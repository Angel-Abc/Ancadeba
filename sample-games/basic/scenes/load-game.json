        "columnSpan": 10
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      }
    },
    {
      "id": "save-slots",
      "type": "save-slots",
      "labelKey": "menu.saveSlots",
      "showName": false,
      "placement": {
        "row": 3,
        "column": 2,
        "rowSpan": 2,
        "columnSpan": 10
      }
    },
    {
      "id": "load-game",
      "type": "button",
      "labelKey": "menu.loadGame",
      "placement": {
        "row": 5,
        "column": 2,
        "rowSpan": 1,
        "columnSpan": 4
      },
      "action": {
        "type": "load-game"
      }
    },
    {
      "id": "load-autosave",
      "type": "button",
      "labelKey": "menu.loadAutosave",
      "placement": {
        "row": 5,
        "column": 7,
        "rowSpan": 1,
        "columnSpan": 4
      },
      "action": {
        "type": "load-autosave"
      }
    },
    {
      "id": "import-save",
      "type": "button",
      "labelKey": "menu.importSave",
      "placement": {
        "row": 7,
        "column": 2,
        "rowSpan": 1,
        "columnSpan": 3
      },
      "action": {
        "type": "import-save"
      }
    },
    {
      "id": "export-save",
      "type": "button",
      "labelKey": "menu.exportSave",
      "placement": {
        "row": 7,
        "column": 5,
        "rowSpan": 1,
        "columnSpan": 3
      },
      "action": {
        "type": "export-save"
      }
    },
    {
      "id": "delete-save",
      "type": "button",
      "labelKey": "menu.deleteSave",
      "placement": {
        "row": 7,
        "column": 8,
        "rowSpan": 1,
        "columnSpan": 3
      },
      "action": {
        "type": "delete-save"
      }
