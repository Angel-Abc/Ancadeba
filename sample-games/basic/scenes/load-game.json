{
  "schema-version": "1.0.0",
  "id": "load-game",
  "type": "stand-alone",
  "titleKey": "menu.loadGame",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
