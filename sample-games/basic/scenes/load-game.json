    {
      "id": "main-menu",
      "type": "button",
      "labelKey": "menu.mainMenu",
      "placement": {
        "row": 11,
        "column": 2,
        "rowSpan": 1,
        "columnSpan": 4
      },
      "action": {
        "type": "main-menu",
        "scene": "start-screen"
      }
    },
    {
      "id": "resume",
      "type": "button",
      "labelKey": "menu.resume",
      "placement": {
        "row": 11,
        "column": 7,
        "rowSpan": 1,
        "columnSpan": 4
      },
      "action": {
        "type": "resume-game"
      }
