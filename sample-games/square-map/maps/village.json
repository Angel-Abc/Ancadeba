    {
      "id": "caravan",
      "label": "Trade caravan",
      "x": 11,
      "y": 4,
      "terrain": "caravan",
      "action": "inspect-caravan",
      "patrol": {
        "mode": "one-way",
        "route": [
          { "x": 11, "y": 4 },
          { "x": 10, "y": 4 },
          { "x": 9, "y": 4 },
          { "x": 8, "y": 4 },
          { "x": 7, "y": 4 },
