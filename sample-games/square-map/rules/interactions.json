{
  "state": [
    { "path": ["courierAside"], "value": false },
    { "path": ["berriesCollected"], "value": false },
    {
      "path": ["signRead"],
      "value": false
    },
    {
      "path": ["chestOpened"],
      "value": false
    },
    {
      "path": ["coins"],
      "value": 0
    },
    {
      "path": ["interactionMessage"],
      "value": "Press E beside an object to interact."
    }
  ],
  "actions": {
    "wait": [
      {
        "when": [],
        "spendsPlayerTurn": true,
        "effects": [
          { "type": "set-state", "path": ["interactionMessage"], "value": "You wait one turn." }
        ]
      }
    ],
    "greet-ranger": [
      {
        "when": [],
        "effects": [
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "Ranger: I walk when you walk."
          }
        ]
      }
    ],
    "greet-watchman": [
      {
        "when": [],
        "effects": [
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "Watchman: I keep watch while you wait."
          }
        ]
      }
    ],
    "step-aside": [
      {
        "when": [{ "type": "state-is", "path": ["courierAside"], "value": false }],
        "effects": [
          {
            "type": "move-map-object",
            "map": "village",
            "object": "courier",
            "direction": "south"
          },
          { "type": "set-state", "path": ["courierAside"], "value": true },
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "The courier steps aside. Speak again to resume the route."
          }
        ]
      },
      {
        "when": [{ "type": "state-is", "path": ["courierAside"], "value": true }],
        "effects": [
          {
            "type": "move-map-object",
            "map": "village",
            "object": "courier",
            "direction": "north"
          },
          { "type": "set-state", "path": ["courierAside"], "value": false },
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "The courier resumes the route."
          }
        ]
      }
    ],
    "collect-berries": [
      {
        "when": [
          { "type": "scene-is", "scene": "exploration" },
          { "type": "payload-is-target", "target": "village-berries" },
          { "type": "state-is", "path": ["berriesCollected"], "value": false }
        ],
        "effects": [
          {
            "type": "collect-items",
            "items": ["berry-1", "berry-2", "berry-3"],
            "owner": "player"
          },
          { "type": "set-state", "path": ["berriesCollected"], "value": true },
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "You collect 3 berries. The basket is gone."
          }
        ]
      }
    ],
    "read-signpost": [
      {
        "when": [
          {
            "type": "scene-is",
            "scene": "exploration"
          },
          {
            "type": "payload-is-target",
            "target": "coast-signpost"
          }
        ],
        "effects": [
          {
            "type": "set-state",
            "path": ["signRead"],
            "value": true
          },
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "Signpost: Pine Village is through the gold gate at (8, 2)."
          }
        ]
      }
    ],
    "open-chest": [
      {
        "when": [
          {
            "type": "scene-is",
            "scene": "exploration"
          },
          {
            "type": "payload-is-target",
            "target": "village-chest"
          },
          {
            "type": "state-is",
            "path": ["chestOpened"],
            "value": false
          }
        ],
        "effects": [
          {
            "type": "set-state",
            "path": ["chestOpened"],
            "value": true
          },
          {
            "type": "set-state",
            "path": ["coins"],
            "value": 25
          },
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "You open the chest and find 25 coins."
          }
        ]
      },
      {
        "when": [
          {
            "type": "scene-is",
            "scene": "exploration"
          },
          {
            "type": "payload-is-target",
            "target": "village-chest"
          },
          {
            "type": "state-is",
            "path": ["chestOpened"],
            "value": true
          }
        ],
        "effects": [
          {
            "type": "set-state",
            "path": ["interactionMessage"],
            "value": "The chest is empty. You already collected its coins."
          }
        ]
      }
    ]
  }
}
